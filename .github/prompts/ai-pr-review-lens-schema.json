{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "status",
    "candidates"
  ],
  "properties": {
    "marker": {
      "type": "string",
      "description": "Exactly the marker requested in the invocation prompt: [LENS-REVIEWED] <lens> <head sha>."
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "blocked"
      ],
      "description": "blocked when repository inspection or the command sandbox failed; never claim no candidates in that case."
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "title",
          "evidence",
          "problem",
          "impact",
          "requiredCorrection"
        ],
        "properties": {
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "requiredCorrection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "DIFF",
            "DIFF_FILE",
            "PR_TITLE",
            "PR_BODY"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "type": "string",
          "enum": [
            "LEFT",
            "RIGHT"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
