{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base",
    "head",
    "status",
    "summary",
    "decisions"
  ],
  "properties": {
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "no-product-change",
        "product-change"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change",
          "before",
          "after",
          "question",
          "decision",
          "paths"
        ],
        "properties": {
          "change": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "question": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 1000
          },
          "decision": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["summary", "source"],
                "properties": {
                  "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "id"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["comment", "review", "review-comment"] },
                      "id": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            ]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
