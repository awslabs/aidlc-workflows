    "session_id": "probe-session-0001",
    "cwd": "/tmp/project"
  },

  "postToolUseExec": {
    "hook_event_name": "PostToolUse",
    "tool_name": "exec",
    "tool_input": { "command": "bun .devin/tools/aidlc-state.ts approve" },
    "tool_response": { "stdout": "ok", "stderr": "", "status": 0 },
    "session_id": "probe-session-0001",
    "cwd": "/tmp/project"
  },

  "postToolUseTodoWrite": {
    "hook_event_name": "PostToolUse",
