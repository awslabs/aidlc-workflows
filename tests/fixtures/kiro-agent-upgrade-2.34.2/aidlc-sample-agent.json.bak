{
  "name": "aidlc-sample-agent",
  "description": "Ein Prüfer — 검토 agent",
  "model": "claude-sonnet-4.5",
  "prompt": "file://./aidlc-sample-agent.md",
  "includeMcpJson": true,
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun *.kiro/tools/aidlc.ts* engine *",
        "git status"
      ],
      "deniedCommands": [
        "rm -rf /"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/**",
        "10",
        "2"
      ]
    }
  },
  "resources": [
    "file://.kiro/aidlc-common/protocols/stage-protocol.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "fs_write",
        "command": "bun .kiro/hooks/aidlc-guard.ts"
      }
    ],
    "agentSpawn": [
      {
        "command": "bun .kiro/hooks/aidlc-session-start.ts"
      }
    ]
  }
}
