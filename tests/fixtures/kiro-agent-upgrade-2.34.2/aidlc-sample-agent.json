{
  "name": "aidlc-sample-agent",
  "description": "Ein Prüfer — 검토 agent",
  "model": "claude-sonnet-4.5",
  "prompt": "file://./aidlc-sample-agent.md",
  "includeMcpJson": true,
  "tools": [
    "read",
    "shell",
    "thinking",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun *.kiro/tools/aidlc.ts* engine *",
        "git status"
      ],
      "deniedCommands": [
        "rm -rf /"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/**",
        "10",
        "2"
      ]
    }
  },
  "resources": [
    "file://.kiro/aidlc-common/protocols/stage-protocol.md"
  ],
  "hooks": [
    {
      "name": "agentSpawn-0",
      "trigger": "agentSpawn",
      "action": {
        "type": "command",
        "command": "bun .kiro/hooks/aidlc-session-start.ts"
      },
      "timeout": 10
    },
    {
      "name": "preToolUse-0",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "bun .kiro/hooks/aidlc-guard.ts"
      },
      "timeout": 10
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "bun*kiro/tools/aidlc*ts* engine *",
          "bun*kiro/tools/aidlc*ts* engine",
          "bun*kiro/tools/aidlc*t engine *",
          "bun*kiro/tools/aidlc*t engine",
          "git status"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "rm -rf /"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "aidlc/**",
          "10",
          "2"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:08635e42165267210aee67ef782e85c97feba39fb20bccc3dbeb24200b4b3c94",
    "source": "sha256:d1602363c853e4f578b5b792ab59064cb3abcca75340aa596ad561674e3c82dc"
  }
}
