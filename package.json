{
  "name": "aidlc",
  "version": "1.0.0",
  "description": "AI-Driven Development Life Cycle (AI-DLC) CLI tool for intelligent software development workflows",
  "main": "dist/index.js",
  "bin": {
    "aidlc": "./bin/aidlc"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run lint && npm run build",
    "test:local": "./scripts/test-local.sh",
    "publish:release": "./scripts/publish.sh"
  },
  "keywords": [
    "ai",
    "development",
    "lifecycle",
    "cli",
    "workflow",
    "automation",
    "agent",
    "kiro",
    "amazon-q"
  ],
  "author": "AI-DLC Team",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/aidlc-workflows.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/aidlc-workflows/issues"
  },
  "homepage": "https://github.com/your-org/aidlc-workflows#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "ora": "^5.4.1",
    "boxen": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/inquirer": "^8.2.10",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "aidlc-rules/",
    "README.md",
    "LICENSE"
  ]
}