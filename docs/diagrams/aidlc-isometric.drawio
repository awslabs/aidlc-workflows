<mxCell id="277" value="&lt;b&gt;AI-DLC · AI-Driven Development Life Cycle&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="-290" y="45" width="900" height="50" as="geometry"/></mxCell>
<mxCell id="278" value="Isometric component &amp; workflow map of aidlc-rules/ — core workflow, phases, stages, extensions, agents and generated artifacts" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="-290" y="99" width="900" height="26" as="geometry"/></mxCell>
<mxCell id="279" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;■ Solid tall block = ALWAYS stage&lt;br&gt;▢ Dashed low block = CONDITIONAL stage (adaptive)&lt;br&gt;▢ Faded tile = future Operations capability&lt;br&gt;→ Solid arrow = workflow sequence&lt;br&gt;⇢ Dashed arrow = rule loading / gating / logging&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule-detail lookup order&lt;/b&gt;&lt;br&gt;1. .aidlc/aidlc-rules/aws-aidlc-rule-details/&lt;br&gt;2. .aidlc-rule-details/ (Cursor, Cline, Claude Code, Copilot, Codex)&lt;br&gt;3. .kiro/aws-aidlc-rule-details/&lt;br&gt;4. .amazonq/aws-aidlc-rule-details/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=11;fontColor=#1E293B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="160" y="160" width="400" height="250" as="geometry"/></mxCell>
<mxCell id="280" value="&lt;b&gt;Key principles&lt;/b&gt;&lt;br&gt;• Adaptive execution — only stages that add value&lt;br&gt;• Transparent plan shown before starting&lt;br&gt;• Extension rules = hard constraints (blocking findings)&lt;br&gt;• Plan &amp; stage checkboxes updated in the same interaction&lt;br&gt;• Every raw user input logged in audit.md (ISO 8601)&lt;br&gt;• Content validated (Mermaid/ASCII) before file creation&lt;br&gt;• Standard 2-option completion messages — no emergent menus" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=11;fontColor=#1E293B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="2000" y="160" width="420" height="190" as="geometry"/></mxCell>
<mxCell id="281" value="&lt;b&gt;Ship &amp; verify&lt;/b&gt;&lt;br&gt;aidlc-rules/ → zipped → GitHub Release&lt;br&gt;CI: markdownlint · conventional commits · contributor statement&lt;br&gt;Scanners: Bandit · Semgrep · Grype · Gitleaks · Checkov · ClamAV&lt;br&gt;aidlc-evaluator (uv): execute → post-run tests → quantitative → contract → qualitative vs golden → report" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=11;fontColor=#1E293B;arcSize=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="160" y="1560" width="560" height="120" as="geometry"/></mxCell>
<mxCell id="282" value="all units done" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#086144;fillColor=#FFFFFF;strokeColor=#086144;rounded=1;arcSize=40;opacity=92;" vertex="1" parent="1"><mxGeometry x="1638" y="1370" width="101" height="20" as="geometry"/></mxCell>
