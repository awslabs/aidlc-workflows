{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex record-human-turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex bind-bash-session"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex deliver-stage-rules"
          }
        ],
        "matcher": "spawn_agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex state-transition-guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex reviewer-scope"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex review-freeze"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex plan-approval-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex record-human-turn"
          }
        ],
        "matcher": "request_user_input"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex audit-and-sensors"
          }
        ],
        "matcher": "apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex sync-workflow-state"
          }
        ],
        "matcher": "update_plan"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex rebuild-stage-graph"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex validate-state"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex log-subagent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .codex/tools/aidlc.ts engine adapter codex continue-workflow"
          }
        ]
      }
    ]
  }
}
