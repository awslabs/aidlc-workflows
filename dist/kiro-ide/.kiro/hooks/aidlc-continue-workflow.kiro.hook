{"version":"1.0.0","enabled":true,"name":"aidlc-continue-workflow","description":"Records whether a running workflow still had pending work when the assistant stopped. Advisory only on Kiro IDE: its Stop trigger cannot block a turn, so keeping the workflow moving relies on the conductor's own Stop protocol.","when":{"type":"agentStop"},"then":{"type":"runCommand","command":"bun .kiro/hooks/aidlc-kiro-adapter.ts continue-workflow"}}
