{"version":"1.0.0","enabled":true,"name":"aidlc-plan-approval-guard","description":"Blocks Code Generation dispatch and workspace mutation until the exact active plan has a human-owned approval receipt.","when":{"type":"preToolUse","toolTypes":["write","shell","subagent",".*invoke_sub_agent.*"]},"then":{"type":"runCommand","command":"bun .kiro/hooks/aidlc-kiro-adapter.ts plan-approval-guard"}}
