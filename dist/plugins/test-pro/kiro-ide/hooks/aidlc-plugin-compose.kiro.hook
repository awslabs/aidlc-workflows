{
  "version": "1.0.0",
  "enabled": true,
  "name": "aidlc-test-pro-compose",
  "description": "Composes the test-pro AIDLC plugin on first interaction.",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "sh -c 'BUN=$(command -v bun || echo \"$HOME/.bun/bin/bun\"); AIDLC_HARNESS_DIR=.kiro \"$BUN\" \"${PLUGIN_ROOT}/hooks/compose.ts\"'"
  }
}
