{
  "title": "Intent State",
  "description": "Tracks progress through the workflow. One 'state' artifact per intent, persisted via the repository (see conventions/repository-interface.md).",
  "type": "object",
  "required": ["intent", "created", "updated", "stages"],
  "properties": {
    "intent": {
      "type": "string",
      "description": "Intent name/slug"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "When the intent was created"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last state update timestamp"
    },
    "stages": {
      "type": "array",
      "description": "Progress for each stage in the composed workflow",
      "items": {
        "type": "object",
        "required": ["stage", "status", "owner"],
        "properties": {
          "stage": {
            "type": "string",
            "description": "Stage name"
          },
          "unit": {
            "type": "string",
            "description": "Unit name for construction-phase stages. Absent for inception stages."
          },
          "scope": {
            "type": "string",
            "description": "Scope name for multi-instance stages. Absent for single-instance stages."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "plan-and-clarify",
              "clarification-asked",
              "clarification-provided",
              "further-clarification",
              "artifact-generated",
              "contribution-needed",
              "contributed",
              "refined",
              "final-review-needed",
              "final-review-complete",
              "finalised",
              "presented",
              "changes-requested",
              "complete"
            ],
            "description": "Current status — set by the actor who performed the action"
          },
          "owner": {
            "type": "string",
            "description": "Persona responsible for this stage"
          },
          "contributors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Personas assigned as contributors"
          },
          "reviewer": {
            "type": "string",
            "description": "Persona assigned as final reviewer (e.g. product-lead)"
          },
          "reviewIterations": {
            "type": "integer",
            "default": 0,
            "description": "Number of owner→reviewer review cycles completed for this stage. Incremented each time the reviewer returns not-ready and the owner re-finalises."
          },
          "contributions": {
            "type": "array",
            "description": "Contribution status for each assigned contributor",
            "items": {
              "type": "object",
              "required": ["persona", "contributed"],
              "properties": {
                "persona": {
                  "type": "string",
                  "description": "Contributor persona name"
                },
                "contributed": {
                  "type": "boolean",
                  "description": "Whether this persona has completed their contribution"
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "description": "List of output artifacts produced. Each is identified by its logical artifact type and address — never by a file path. The active repository adapter resolves the address to physical storage. See conventions/repository-interface.md.",
            "items": {
              "type": "object",
              "required": ["type", "address"],
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Logical artifact type from the catalog in conventions/repository-interface.md (e.g. 'intent', 'requirements', 'components'). Carries no format or extension."
                },
                "address": {
                  "type": "object",
                  "description": "Backend-neutral ArtifactAddress locating this artifact (see conventions/repository-interface.md).",
                  "required": ["container", "type"],
                  "properties": {
                    "container": {
                      "type": "string",
                      "enum": ["intent-root", "state", "audit", "stage"],
                      "description": "Which logical store the artifact lives in."
                    },
                    "phase": {
                      "type": "string",
                      "enum": ["inception", "construction", "operations"],
                      "description": "Workflow phase. Present when container = 'stage'."
                    },
                    "stage": {
                      "type": "string",
                      "description": "Stage name. Present when container = 'stage'."
                    },
                    "unit": {
                      "type": "string",
                      "description": "Unit name for construction-phase stage instances."
                    },
                    "scope": {
                      "type": "string",
                      "description": "Scope name for multi-instance stages."
                    },
                    "type": {
                      "type": "string",
                      "description": "Logical artifact type (matches the sibling 'type' field)."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
