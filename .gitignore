node_modules/
.claude/CLAUDE.md
.claude/settings.json
.claude/settings.local.json
.env
.DS_Store
._*

# Bun transient compilation artifacts
*.bun-build

# Generated AI-DLC artifacts (recreated by workflow runs / doctor)
dist/claude/aidlc-docs/
dist/kiro/aidlc-docs/
dist/codex/aidlc-docs/
build/

# Zensical documentation-site build output and env (`uv run zensical build`;
# deployed by .github/workflows/docs.yml, never committed)
/site/
/.cache/
/.venv/

# Sample/test projects
dist/claude/todo-app/

# Test verbose logs
tests/logs/

# Claude worktrees
.claude/worktrees

# AIDLC runtime state (Construction worktrees + future runtime artefacts).
# Anchored to repo root; distinct from .claude/worktrees above which is
# the framework-development worktree convention.
/.aidlc/
/aidlc/spaces/*/intents/.aidlc-*

# AIDLC Express workflow runtime artifacts (generated when running AIDLC
# in this repo for implementation tracking — not framework source).
/aidlc-state.md
/aidlc-audit/
/aidlc-artifacts/
/aidlc/spaces/*/aidlc-state.md
/aidlc/spaces/*/audit/
/aidlc/spaces/*/artifacts/

# PR #996 implementation runbook working artifacts (Express flow tracking)
/.aidlc-impl/

# Local scratch — explainers, throwaway HTML, etc. (claude writes explainers here)
tmp/

# Local Claude Code memory (personal project preferences, not checked in)
CLAUDE.local.md

# Local-only — pins shfmt formatting to project style via a local
# auto-format tool. Not committed; contributors who do not use it do not need it.
.editorconfig

# Local-only formatter/linter cache — match at any depth so a cache
# directory anywhere in the repo (root, dist/, tools/, etc.) is ignored.
**/.pi-lens/
.pi-lens/
