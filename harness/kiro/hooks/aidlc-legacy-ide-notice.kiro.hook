{
  "version": "1.0.0",
  "enabled": true,
  "name": "aidlc-legacy-ide-notice",
  "description": "Tells Kiro IDE 0.x users to upgrade; AI-DLC requires a current Kiro IDE.",
  "when": { "type": "promptSubmit" },
  "then": {
    "type": "runCommand",
    "command": "{{INVOKE}} engine adapter kiro legacy-ide-notice"
  }
}
