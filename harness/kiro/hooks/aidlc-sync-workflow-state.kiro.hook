{"version":"1.0.0","enabled":true,"name":"aidlc-sync-workflow-state","description":"Keeps the workflow's Current Stage in aidlc-state.md in step with what has actually happened, so the status line and progress display stay accurate.","when":{"type":"postToolUse","toolTypes":["spec"]},"then":{"type":"runCommand","command":"bun .kiro/hooks/aidlc-kiro-adapter.ts sync-workflow-state"}}
