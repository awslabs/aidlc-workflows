{
  "name": "aidlc-product-lead-agent",
  "description": "AI-DLC Product Lead Reviewer \u2014 delegation target for reviewing requirements, user stories, and mockups.",
  "prompt": "file://aidlc-product-lead-agent.md",
  "includeMcpJson": true,
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking",
    "@context7",
    "@aws-mcp",
    "@aws-pricing",
    "@aws-iac",
    "@aws-serverless"
  ],
  "allowedTools": [
    "fs_read",
    "fs_write",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun (run )?[\"']?\\.kiro/tools/[A-Za-z0-9._-]+\\.ts[\"']?( .*)?",
        "date -u( .*)?"
      ],
      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/knowledge/aidlc-shared/*.md",
    "file://aidlc/spaces/default/memory/**/*.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/hooks/aidlc-kiro-adapter.ts state-transition-guard aidlc-product-lead-agent",
        "timeout_ms": 15000
      },
      {
        "matcher": "fs_read",
        "command": "bun .kiro/hooks/aidlc-kiro-adapter.ts reviewer-scope aidlc-product-lead-agent",
        "timeout_ms": 15000
      },
      {
        "matcher": "fs_write",
        "command": "bun .kiro/hooks/aidlc-kiro-adapter.ts reviewer-scope aidlc-product-lead-agent",
        "timeout_ms": 15000
      },
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/hooks/aidlc-kiro-adapter.ts reviewer-scope aidlc-product-lead-agent",
        "timeout_ms": 15000
      },
      {
        "matcher": "fs_write",
        "command": "bun .kiro/hooks/aidlc-kiro-adapter.ts review-freeze",
        "timeout_ms": 15000
      },
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/hooks/aidlc-kiro-adapter.ts review-freeze",
        "timeout_ms": 15000
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "bun .kiro/hooks/aidlc-kiro-adapter.ts audit-and-sensors",
        "timeout_ms": 120000
      }
    ]
  }
}
